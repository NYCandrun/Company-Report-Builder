{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation.schema.json",
  "title": "Fail-closed validation result",
  "type": "object",
  "required": ["schema_version", "checker", "checker_version", "status", "expected_count", "checked_count", "failure_count", "exception_count", "input_hashes", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "checker": {"type": "string", "minLength": 1},
    "checker_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "expected_count": {"type": "integer", "minimum": 0},
    "checked_count": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "exception_count": {"type": "integer", "minimum": 0},
    "failures": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "completed_at": {"type": "string", "minLength": 1},
    "details": {"type": "object"}
  },
  "additionalProperties": true
}
