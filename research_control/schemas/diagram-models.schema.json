{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagram-models.schema.json",
  "title": "Auditable architecture diagram models",
  "type": "object",
  "required": ["entities", "relationships", "diagrams"],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "entity_type", "owner_boundary", "evidence_class", "fact_ids", "source_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "entity_type": {"type": "string", "minLength": 1},
          "owner_boundary": {"type": "string", "minLength": 1},
          "evidence_class": {"enum": ["D", "R", "H", "U"]},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "reasoning_note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "relationship", "direction", "qualifier", "scope", "evidence_class", "fact_ids", "source_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "relationship": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "minLength": 1},
          "qualifier": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "evidence_class": {"enum": ["D", "R", "H", "U"]},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "reasoning_note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "diagrams": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "title", "subtitle", "question_answered", "main_takeaway", "entity_ids", "relationship_ids", "structure", "deliberate_omissions", "caveats"],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
