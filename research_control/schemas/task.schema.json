{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Bounded agent task packet",
  "type": "object",
  "required": ["schema_version", "task_id", "phase", "task_type", "independent", "inputs", "outputs", "prompt_files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "independent": {"type": "boolean"},
    "track_input_staleness": {"type": "boolean"},
    "inputs": {"type": "array"},
    "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "prompt_files": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "schema_files": {"type": "array", "items": {"type": "string"}},
    "depends_on": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
